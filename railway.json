{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "env": {
      "RAILPACK_PYTHON_PLAYWRIGHT_INSTALL": "1"
    },
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": [
            "pip install -r requirements.txt",
            "playwright install chromium",
            "playwright install-deps chromium"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "python main.py"
  }
}
